Description: virtio/vulkan: force 16 KiB allocation alignment
Origin: https://gitlab.freedesktop.org/slp/mesa/-/commit/761ef1ec5ff2aae1cc3dc8bbc22b3d06ef04b549
Forwarded: not-needed

Force 16 KiB alignment for Venus (virtio-vulkan) allocations.

Required for GPU access on containers running with libkrun
on Mac silicon.

Without this, every Vulkan call in the container dies:

    vulkaninfo
    ERROR at ./vulkaninfo/./vulkaninfo.h:458:vkCreateInstance failed with ERROR_OUT_OF_HOST_MEMORY

Upstream is gitlab.freedesktop.org/slp/mesa, branch
mesa-libkrun-vulkan, commit 761ef1ec, "virtio/vulkan: force 16k alignment
for allocations (HACK)".
https://gitlab.freedesktop.org/slp/mesa/-/commit/761ef1ec5ff2aae1cc3dc8bbc22b3d06ef04b549

Added over upstream: util/u_math.h includes, because align64() lives
there

--- a/src/virtio/vulkan/vn_ring.c
+++ b/src/virtio/vulkan/vn_ring.c
@@ -9,6 +9,8 @@

 #include "venus-protocol/vn_protocol_driver_transport.h"

+#include "util/u_math.h"
+
 #include "vn_cs.h"
 #include "vn_instance.h"
 #include "vn_renderer.h"
@@ -264,7 +266,8 @@
    layout->extra_offset = layout->buffer_offset + layout->buffer_size;
    layout->extra_size = extra_size;

-   layout->shmem_size = layout->extra_offset + layout->extra_size;
+   layout->shmem_size =
+      align64(layout->extra_offset + layout->extra_size, 16384);
 }

